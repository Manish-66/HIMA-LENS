# ==============================================================================
# HIMA-LENS .gitignore
# ==============================================================================

# Environment & local secrets
.env
.env.*
!.env.example
*.key
*.pem

# AI Agent Frameworks & Local Workspace Tooling
# (Keeps local agent skills on your disk without polluting the public Git repository)
.agents/
skills-lock.json
.kilo/
graphify-out/

# Python virtual environment & bytecode
.venv/
env/
venv/
pyvenv.cfg
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Runtime Caches & Dynamic Alert Dumps
data/ai_assessments_cache.json
data/cap_alerts/*.xml

# Editor & OS artifacts
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
tempCodeRunnerFile.*

# Archived files & scratch
archived_root_files/
scratch/
*.tmp
*.bak

# User uploads (preserve .gitkeep)
static/uploads/reports/*
!static/uploads/reports/.gitkeep
static/uploads/annotated/*
!static/uploads/annotated/.gitkeep

# Vision weights & evaluation caches
*.pt
evaluation_output/

# Heavy binary documents and 3D models (allow mountain.glb for Terrain Lab)
*.glb
!static/models/mountain.glb
*.pdf
*.docx
templates/preview_hero.html
static/css/preview_hero.css
static/js/preview_hero.js
src/ts/preview_hero.ts
src/ts/globals.d.ts

# Unneeded heavy data packages & legacy dumps
Mandi_data/
old_data.geojson
*.lpkx
