# Environment configuration template for HIMA-LENS
# Copy this file to .env, and fill in your actual API credentials.
# Never commit the .env file to version control.

# Cesium Ion Access Token (for 3D Terrain & Satellite Globe)
CESIUM_ION_TOKEN=""

# Supabase Database & Cloud Storage
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="report-images"

# Google Gemini Vision API (for Automated Geotechnical AI Assessment & VLM)
GEMINI_API_KEY=""

# Roboflow Foundation Vision & SAM-3 Segmentation API
ROBOFLOW_API_KEY=""
ROBOFLOW_WORKSPACE=""
ROBOFLOW_INFER_URL="https://infer.roboflow.com"
